# Local embedding model (downloaded from Hugging Face on first run)
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local chat model (downloaded by Docker Compose on first run)
OLLAMA_CHAT_MODEL=qwen2.5:3b

# Chroma settings
CHROMA_COLLECTION_NAME=financial-documents
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Local development: use http://localhost:11434.
# Docker Compose overrides this with http://ollama:11434.
OLLAMA_BASE_URL=http://localhost:11434
